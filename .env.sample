# SongYUE2 로컬 설정 예시 파일입니다.
# 이 파일을 복사해 같은 폴더에 ".env"로 저장한 뒤 실제 값을 입력하세요.
# .env 파일은 git에 커밋되지 않습니다 (.gitignore 참고).
# 값을 바꾼 뒤에는 앱을 다시 실행해야 반영됩니다.

# 가사/스타일 작사 도우미로 사용할 LLM 제공업체
# none(사용 안 함) | ollama | claude | chatgpt | gemini
LLM_PROVIDER=none

# Ollama (내 PC에서 실행, API 키 불필요, localhost 주소만 허용)
OLLAMA_ENDPOINT=http://127.0.0.1:11434
# 설치한 모델 이름 중 하나를 선택해 입력하세요 (예: ollama list로 확인)
# 예: llama3.1 | qwen2.5 | mistral | gemma2
OLLAMA_MODEL=

# Claude (Anthropic API)
# 접속 주소 — 보통 바꿀 필요 없음. 사내 프록시/게이트웨이를 쓸 때만 변경하세요.
CLAUDE_ENDPOINT=https://api.anthropic.com/v1/messages
CLAUDE_API_KEY=
# 아래 중 하나를 선택해 입력하세요 (성능 우선순위: opus > sonnet > haiku)
# claude-opus-5   : 가장 강력함, 비용 높음
# claude-sonnet-5 : 성능과 비용의 균형 (추천)
# claude-haiku-4-5: 가장 빠르고 저렴함
CLAUDE_MODEL=

# ChatGPT (OpenAI API)
# 접속 주소 — 보통 바꿀 필요 없음. 사내 프록시/게이트웨이를 쓸 때만 변경하세요.
OPENAI_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_API_KEY=
# 아래 중 하나를 선택해 입력하세요. 정확한 최신 모델명은
# https://platform.openai.com/docs/models 에서 확인하세요 (자주 바뀝니다)
# gpt-5.1      : 최신 플래그십, 코딩/에이전트 작업에 강함
# gpt-5.1-mini : 저비용 경량 버전
# gpt-4o-mini  : 구형이지만 저렴하고 안정적인 대안
OPENAI_MODEL=

# Gemini (Google AI API)
# 접속 주소 — 보통 바꿀 필요 없음. 사내 프록시/게이트웨이를 쓸 때만 변경하세요.
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
# 아래 중 하나를 선택해 입력하세요. 정확한 최신 모델명은
# https://ai.google.dev/gemini-api/docs/models 에서 확인하세요 (자주 바뀝니다)
# gemini-3-pro-preview   : 가장 강력함
# gemini-3-flash-preview : 빠르고 저비용
# gemini-2.5-flash       : 구형이지만 안정적인 대안
GEMINI_MODEL=

# 음악 생성 엔진(audio.cpp) 실행 파일 경로 — 선택 사항, 설정 화면에서도 지정할 수 있습니다.
# audio.cpp는 아직 yue2 지원이 dev 브랜치에만 있어 프리빌드 바이너리가 없습니다.
# docs/audiocpp-setup.md 안내대로 소스에서 직접 빌드해야 합니다.
# 문서의 권장 위치(engine/audio.cpp)에 클론해 빌드했다면 결과물은 다음 경로에 생성됩니다.
# 예: C:\Claude\SongYUE2\engine\audio.cpp\build\windows-cuda-release\bin\audiocpp_cli.exe
ENGINE_PATH=

# 공식 Python YuE2("원본" 모델) 실행 파일/스크립트 경로 — 선택 사항.
# PYTHON_SCRIPT_PATH는 examples/generate.py가 아니라 skills/yue2-music/scripts/run_yue2.py를 가리켜야 합니다
# (plan/generate 하위 명령과 --memory-budget-gib를 지원합니다. abc_tools.py도 같은 폴더에 있어야 악보 검사가 됩니다).
# 공식 문서는 24GB급 VRAM을 권장하지만, PYTHON_MEMORY_BUDGET_GIB를 낮추면 12GB급 카드에서도 짧은 곡은 동작합니다(실측 확인).
# 설치 방법 전체는 docs/python-engine-setup.md 참고.
PYTHON_ENGINE_PATH=
PYTHON_SCRIPT_PATH=
PYTHON_MEMORY_BUDGET_GIB=11

# SheetSage2 전용 Python 실행 파일 경로 — 선택 사항 (완성곡 "커버"/작곡 화면 "오디오에서 추출" 기능에만 필요).
# 위 PYTHON_ENGINE_PATH와는 완전히 별도의 가상환경이어야 합니다(torch/transformers 버전이 서로 다름).
# transcribe.py 스크립트 경로는 PYTHON_SCRIPT_PATH와 같은 폴더에서 자동으로 찾으므로 별도 설정이 없습니다.
# 설치 방법은 docs/python-engine-setup.md의 SheetSage2 절 참고.
SHEETSAGE_PYTHON_PATH=

# 라이브러리 폴더 — 모두 SongYUE2 폴더 기준 상대 경로이며, 비워두면 아래 기본값이 사용됩니다.
# 폴더가 없으면 자동으로 만들어집니다. 설정 화면에서도 지정할 수 있습니다.
SETTING_PATH=Library\Setting
MUSIC_PATH=Library\Music
EXAMPLES_PATH=Library\Examples
COVERS_PATH=Library\Cover
ABC_NOTES_PATH=Library\Abc-Note

# 완성곡 저장 파일 형식: wav | flac | mp3 | mp4 (MUSIC_PATH 폴더에 이 형식으로 저장됩니다)
# wav 이외의 형식은 ffmpeg가 PATH에 있어야 변환됩니다(없으면 wav로 대신 저장됩니다).
SAVE_FORMAT=wav
