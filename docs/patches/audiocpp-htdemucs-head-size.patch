+// The CUDA flash-attention kernels exist only for some head sizes; htdemucs_6s has 48 (384 / 8 heads), which aborts the process
+// ("fatal error" in fattn.cu). Other sizes use the plain matmul / softmax path that the CPU backend already uses.
+// AUDIOCPP_DEMUCS_NO_FLASH=1 forces that path (for comparing the two).
+bool flash_attention_supported(int64_t head_dim) {
+    if (const char * off = std::getenv("AUDIOCPP_DEMUCS_NO_FLASH"); off != nullptr && off[0] == '1') {
+        return false;
+    }
+    return head_dim == 64 || head_dim == 80 || head_dim == 96 || head_dim == 112 || head_dim == 128 || head_dim == 256;
+}
